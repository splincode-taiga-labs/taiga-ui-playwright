{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "integration",
  "projects": {
    "fixture": {
      "projectType": "application",
      "root": "integration/angular-app",
      "sourceRoot": "integration/angular-app/src",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/fixture",
            "index": "integration/angular-app/src/index.html",
            "browser": "integration/angular-app/src/main.ts",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "integration/angular-app/tsconfig.app.json",
            "assets": [],
            "styles": [
              "integration/angular-app/src/styles.less"
            ]
          },
          "configurations": {
            "production": {
              "optimization": true,
              "outputHashing": "none"
            },
            "development": {
              "optimization": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "development"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "buildTarget": "fixture:build:development"
          }
        }
      }
    },
    "docs": {
      "projectType": "application",
      "root": "docs/site",
      "sourceRoot": "docs/site/src",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/docs",
            "index": "docs/site/src/index.html",
            "browser": "docs/site/src/main.ts",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "docs/site/tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "docs/site/public",
                "output": "/"
              },
              {
                "glob": "*.ts",
                "input": "src",
                "output": "/assets/harness-sources"
              },
              {
                "glob": "**/*.svg",
                "input": "node_modules/@taiga-ui/icons/src",
                "output": "assets/taiga-ui/icons"
              }
            ],
            "styles": [
              "docs/site/src/styles.less"
            ]
          },
          "configurations": {
            "production": {
              "optimization": true,
              "outputHashing": "all",
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "3mb",
                  "maximumError": "5mb"
                }
              ]
            },
            "development": {
              "optimization": false,
              "sourceMap": true,
              "outputHashing": "none"
            }
          },
          "defaultConfiguration": "development"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "buildTarget": "docs:build:development"
          }
        }
      }
    }
  }
}
