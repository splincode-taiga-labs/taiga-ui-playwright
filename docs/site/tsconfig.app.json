{
  "compilerOptions": {
    "outDir": "../../dist/docs-ts",
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "strict": true,
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "skipLibCheck": true,
    "sourceMap": true,
    "types": []
  },
  "angularCompilerOptions": {
    "strictTemplates": true,
    "strictInjectionParameters": true
  },
  "files": [
    "src/main.ts",
    "src/app.ts",
    "src/harness-matrix.ts",
    "src/guide.ts",
    "src/harness-catalog.ts"
  ]
}
