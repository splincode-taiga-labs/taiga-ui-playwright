{
  "name": "@taiga-ui-labs/playwright",
  "version": "0.0.0",
  "private": true,
  "description": "Experimental Playwright-native element objects for Taiga UI",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "playwright test",
    "verify": "npm run typecheck && npm run build && npm run build:fixture && npm test",
    "start:fixture": "ng serve fixture --host 127.0.0.1 --port 4201",
    "build:fixture": "ng build fixture",
    "test:dom": "playwright test --project=dom",
    "test:integration": "playwright test --project=integration"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.50.0 <2"
  },
  "devDependencies": {
    "@angular/build": "20.3.0",
    "@angular/cdk": "20.2.14",
    "@angular/cli": "20.3.0",
    "@angular/common": "20.3.0",
    "@angular/compiler": "20.3.0",
    "@angular/compiler-cli": "20.3.0",
    "@angular/core": "20.3.0",
    "@angular/forms": "20.3.0",
    "@angular/platform-browser": "20.3.0",
    "@angular/router": "20.3.0",
    "@playwright/test": "^1.56.0",
    "@taiga-ui/cdk": "5.28.0",
    "@taiga-ui/core": "5.28.0",
    "@taiga-ui/kit": "5.28.0",
    "@taiga-ui/styles": "5.28.0",
    "@types/node": "^22.0.0",
    "less": "4.4.2",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "typescript": "^5.9.3",
    "zone.js": "0.15.1"
  }
}
