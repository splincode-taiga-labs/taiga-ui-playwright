{
  "name": "@taiga-ui-labs/playwright",
  "version": "0.0.0",
  "private": true,
  "description": "Experimental Playwright-native element objects for Taiga UI",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "playwright test",
    "verify": "npm run typecheck && npm run build && npm run build:fixture && npm test",
    "start:fixture": "ng serve fixture --host 127.0.0.1 --port 4201",
    "build:fixture": "ng build fixture",
    "test:dom": "playwright test --project=dom",
    "test:integration": "playwright test --project=integration",
    "start:docs": "ng serve docs --host 127.0.0.1 --port 4202",
    "build:docs": "ng build docs --configuration production",
    "build:docs:pages": "ng build docs --configuration production --base-href=/taiga-ui-playwright/",
    "test:docs": "playwright test --config playwright.docs.config.ts"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.51.0 <2"
  },
  "devDependencies": {
    "@angular/build": "20.3.0",
    "@angular/cdk": "20.2.14",
    "@angular/cli": "20.3.0",
    "@angular/common": "20.3.0",
    "@angular/compiler": "20.3.0",
    "@angular/compiler-cli": "20.3.0",
    "@angular/core": "20.3.0",
    "@angular/forms": "20.3.0",
    "@angular/platform-browser": "20.3.0",
    "@angular/router": "20.3.0",
    "@ng-web-apis/common": "5.4.0",
    "@ng-web-apis/platform": "5.4.0",
    "@playwright/test": "^1.56.0",
    "@taiga-ui/addon-doc": "5.28.0",
    "@taiga-ui/cdk": "5.28.0",
    "@taiga-ui/core": "5.28.0",
    "@taiga-ui/icons": "5.28.0",
    "@taiga-ui/kit": "5.28.0",
    "@taiga-ui/layout": "5.28.0",
    "@taiga-ui/legacy": "5.28.0",
    "@taiga-ui/styles": "5.28.0",
    "@types/markdown-it": "14.2.0",
    "@types/node": "^22.0.0",
    "highlight.js": "11.11.1",
    "less": "4.4.2",
    "markdown-it": "14.3.2",
    "ngx-highlightjs": "14.0.1",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "typescript": "^5.9.3",
    "zone.js": "0.15.1"
  }
}
