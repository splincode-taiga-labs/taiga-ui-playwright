{
  "name": "@taiga-ui-labs/playwright",
  "version": "0.0.0",
  "private": true,
  "description": "Experimental Playwright-native element objects for Taiga UI",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "playwright test",
    "verify": "npm run typecheck && npm run build && npm test"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.50.0 <2"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3"
  }
}
